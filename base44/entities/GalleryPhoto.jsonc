{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "men",
        "women",
        "other"
      ],
      "default": "men"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    }
  },
  "required": [
    "photo_url"
  ]
}